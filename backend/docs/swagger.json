    "definitions": {
        "routers.BusScoreRequest": {
            "type": "object",
            "required": [
                "accuracy",
                "level",
                "successNum",
                "trainingNum",
                "userId"
            ],
            "properties": {
                "accuracy": {
                    "type": "number"
                },
                "level": {
                    "type": "string"
                },
                "successNum": {
                    "type": "integer"
                },
                "trainingNum": {
                    "type": "integer"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "routers.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "routers.MatrixResponse": {
            "type": "object",
            "properties": {
                "matrix": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "size": {
                    "type": "integer"
                }
            }
        },
        "routers.MemoryMatrixResponse": {
            "type": "object",
            "properties": {
                "answerTime": {
                    "description": "返回 回答时间",
                    "type": "number"
                },
                "difficulty": {
                    "description": "返回 等级难度",
                    "type": "string"
                },
                "displayTime": {
                    "description": "返回 展示时间",
                    "type": "number"
                },
                "positions": {
                    "description": "返回的要亮的 15 个数字",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "totalCells": {
                    "description": "返回一共所有的单元格",
                    "type": "integer"
                }
            }
        },
        "routers.MemoryScoreRequest": {
            "type": "object",
            "required": [
                "accuracy",
                "level",
                "successNum",
                "trainingNum",
                "userId"
            ],
            "properties": {
                "accuracy": {
                    "type": "number"
                },
                "level": {
                    "type": "string"
                },
                "successNum": {
                    "type": "integer"
                },
                "trainingNum": {
                    "type": "integer"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "routers.RegisterRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "description": "Email    string `json:\"email\" binding:\"required,email\"`",
                    "type": "string",
                    "minLength": 6
                },
                "username": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 3
                }
            }
        },
        "routers.SchulteScoreRequest": {
            "type": "object",
            "required": [
                "isPassed",
                "trainingNum",
                "userId"
            ],
            "properties": {
                "isPassed": {
                    "type": "boolean"
                },
                "trainingNum": {
                    "type": "integer"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "routers.ScoreRequest": {
            "type": "object",
            "required": [
                "accuracy",
                "level",
                "success_num",
                "training_num",
                "userId"
            ],
            "properties": {
                "accuracy": {
                    "type": "number"
                },
                "level": {
                    "type": "string"
                },
                "success_num": {
                    "type": "integer"
                },
                "training_num": {
                    "type": "integer"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "routers.UserUpdateRequest": {
            "type": "object",
            "required": [
                "email",
                "userId",
                "username"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "userId": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}