                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "公交车人数"
                ],
                "summary": "提交公交车训练成绩",
                "parameters": [
                    {
                        "type": "string",
                        "default": "Bearer \u003cyour_token\u003e",
                        "description": "Bearer Token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "成绩数据",
                        "name": "score",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routers.BusScoreRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
