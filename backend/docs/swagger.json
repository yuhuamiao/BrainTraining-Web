        "/api/v1/schulte/matrix": {
            "get": {
                "description": "为舒尔特表格提供随机数字矩阵",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "舒尔特矩阵"
                ],
                "summary": "舒尔特表格",
                "parameters": [
                    {
                        "maximum": 10,
                        "minimum": 3,
                        "type": "integer",
                        "default": 5,
                        "description": "矩阵大小（如 5 表示 5x5 矩阵）",
                        "name": "size",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回矩阵数据",
                        "schema": {
                            "$ref": "#/definitions/routers.MatrixResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/schulte/scores": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "保存用户舒尔特表格游戏成绩",
