PORT=8000
GIN_MODE=debug
JWT_SECRET=replace-with-a-long-random-secret

# Default: local SQLite database
DB_DRIVER=sqlite
DB_PATH=./data/brain-training.db

# Optional MySQL configuration (set DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brain_training

# Optional when the frontend calls the API from another origin
CORS_ALLOWED_ORIGIN=http://localhost:5173
